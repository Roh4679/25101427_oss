{
  "name": "vibe-signoff",
  "version": "0.0.0",
  "description": "바이브코딩으로 만든 웹 서비스를 배포 전에 점검하는 CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vibe-signoff": "dist/cli.js"
  },
  "files": [
    "dist",
    "knowledge"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run src",
    "test:fixtures": "vitest run test/fixtures",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
