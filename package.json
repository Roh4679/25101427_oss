{
  "name": "pii-guard-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
    "web": "npm run dev -w @pii-guard/web",
    "build:web": "npm run build -w @pii-guard/web",
    "preview:web": "npm run preview -w @pii-guard/web"
  },
  "devDependencies": {
    "@types/node": "^24.19.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
